# R.O.B.I. (Robodemy Operational Brain & Intelligence) Yapılandırması

# --- 1. Temel Sunucu & Güvenlik ---
PORT=3000
# 🛡️ YÖNETİCİ ŞİFRESİ: Web paneline ve API'lere erişim için zorunlu şifre (Varsayılan: robodemy2026)
ROBI_ADMIN_PASSWORD=guclu_bir_sifre_belirleyin

# LLM Beyin (NVIDIA Nemotron)
NVIDIA_API_KEY=your_nvidia_api_key_here
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_FALLBACK_MODEL=meta/llama-3.1-nemotron-70b-instruct
BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
MEDIA_DIR=./media

# --- 2. Proaktif Bildirim Kanalı (Telegram Bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 3. E-Posta Yönetimi (IMAP / SMTP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seninmailin@gmail.com
IMAP_PASS=xxxx-xxxx-xxxx-xxxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seninmailin@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# --- 4. Zamanlayıcı & Sabah Brifingi ---
BRIEFING_TIME=08:30
BRIEFING_CITY=Istanbul

# --- 5. Sistem & Disk Alarmları ---
DISK_ALERT_THRESHOLD=85

# --- 6. n8n Entegrasyonu ---
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
